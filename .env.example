# ─── Jamaroff · variables de entorno ───────────────────────────────
# Copia este archivo como .env y completa los valores.

# Tu dominio (sin https://) y la dirección pública completa
DOMAIN=jamaroff.cl
SITE_URL=https://jamaroff.cl

# Clave de la base de datos (inventa una larga, solo letras y números)
POSTGRES_PASSWORD=cambia-esta-clave
# Solo para desarrollo local (en el VPS lo arma docker-compose):
# DATABASE_URL=postgres://jamaroff:jamaroff@localhost:5432/jamaroff

# Clave secreta para las sesiones (genera una con: openssl rand -hex 32)
AUTH_SECRET=

# ─── Webpay Plus (Transbank) ───────────────────────────────────────
# "integration" = pruebas con tarjetas de prueba, "production" = cobros reales.
WEBPAY_ENV=integration
# En producción, Transbank te entrega estos dos datos:
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# ─── Correo (SMTP de Hostinger u otro) ─────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=ventas@jamaroff.cl
SMTP_PASS=
MAIL_FROM="Jamaroff Home Atelier <ventas@jamaroff.cl>"
# Correo que recibe los avisos de nuevos pedidos y solicitudes
ADMIN_NOTIFY_EMAIL=ventas@jamaroff.cl

# ─── Conexión con Cuadra (ERP) ─────────────────────────────────────
# Clave que comparten la tienda y Cuadra (genera una con: openssl rand -hex 24).
# Anota la misma en Cuadra → Configuración → Conexiones → Tienda web. Vacía = conexión apagada.
CUADRA_API_KEY=
